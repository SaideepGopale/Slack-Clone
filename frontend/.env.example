# Frontend environment variables
# Copy to .env and fill in values

# Backend origin. Only needed when the frontend and backend are on different
# origins (e.g. separate Render services) — leave unset for local dev, where
# Vite's dev proxy (see vite.config.ts) forwards /api and /uploads to the
# backend automatically.
# VITE_API_URL=https://your-backend.onrender.com
# VITE_BACKEND_URL=https://your-backend.onrender.com

# Invitations are sent by the backend (nodemailer) — no frontend email
# credentials needed here anymore.

# Audio/video calling is now pure WebRTC (native RTCPeerConnection, signaled
# over the existing Socket.IO connection) — no third-party call credentials needed.
