generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum WorkspaceRole {
  ADMIN
  MEMBER
}

// Batch 3 — organization roles. Separate from WorkspaceRole (tenant level)
// and from the platform-wide User.role (frozen admin authentication).
enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

// Who may create channels in a workspace (workspace setting).
enum ChannelCreationPolicy {
  MEMBERS
  ADMINS
}

// Batch 3/D. Channel types are two orthogonal settings: visibility
// (PUBLIC = discoverable by workspace members, PRIVATE = members only) and
// Channel.isAnnouncement (only owners/moderators/workspace admins post
// top-level messages). Ignored for DMs/group DMs (always membership-only).
enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

// Batch 3/C. PUBLIC projects are discoverable by every workspace member;
// PRIVATE projects (and their channels) only by project members, plus
// workspace/organization managers for management metadata (never content).
enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

// Exactly one OWNER per project, kept in application logic under a row lock
// (projects.service.ts) — ownership is a role row, not a column on Project,
// so the frozen admin delete-user flow (FK cascade) needs no changes.
enum ProjectRole {
  OWNER
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                      String                 @id @default(uuid())
  username                String                 @unique
  // Also unique case-insensitively: "User_email_lower_key" ON "User"(lower(email)),
  // migration 20261111100000_user_email_case_insensitive_unique (T.26/T.27). Prisma
  // cannot express expression indexes and ignores this one in migrate diff.
  email                   String                 @unique
  password                String
  // Workspace-level role — unifies the old email-heuristic (`isAdminUser`)
  // and the separate hardcoded admin-login check into one real DB field.
  // Not to be confused with ChannelMember.role, which is per-channel.
  role                    Role                   @default(USER)
  // Replaces the old isBanned boolean — a suspended user should be able to
  // be reinstated without an admin needing to reconstruct "was this a ban or
  // a suspension" from a single flag that could only ever mean "banned".
  status                  UserStatus             @default(ACTIVE)
  channels                Channel[]              @relation("UserCreatedChannels")
  messages                Message[]
  memberships             ChannelMember[]
  invitationsSent         Invitation[]           @relation("UserInvites")
  reactions               Reaction[]
  auditLogs               AuditLog[]             @relation("AuditLogActor")
  ownedWorkspaces         Workspace[]            @relation("WorkspaceOwner")
  workspaces              WorkspaceMember[]
  notifications           Notification[]
  // Where to land this user on login/signup — set once at signup (see
  // joinGeneralChannel in auth.service.ts) and kept in sync whenever they
  // switch workspaces (WorkspaceLayout.tsx calls PATCH /api/users/me/active-
  // workspace). SetNull rather than Cascade/Restrict: losing this is a UX
  // regression (falls back to "first workspace in the list"), not a reason
  // to block deleting the workspace itself or the user.
  lastActiveWorkspaceId   String?
  lastActiveWorkspace     Workspace?             @relation("UserLastActiveWorkspace", fields: [lastActiveWorkspaceId], references: [id], onDelete: SetNull)
  joinRequests            WorkspaceJoinRequest[]
  inviteLinksCreated      WorkspaceInviteLink[]  @relation("InviteLinkCreator")
  // Collaboration profile/preferences live in their own table so the User
  // (authentication) table itself is never altered by collaboration features.
  profile                 UserProfile?
  organizationMemberships OrganizationMember[]
  projectMemberships      ProjectMember[]
  projectsCreated         Project[]              @relation("ProjectCreatedBy")
  projectsArchived        Project[]              @relation("ProjectArchivedBy")
  channelsArchived        Channel[]              @relation("ChannelArchivedBy")
  // Stage 1 (T.19): company hierarchy tier, kept in its own table (relation
  // fields only — no column of this authentication table changes).
  accountTier             AccountTierGrant?      @relation("AccountTierHolder")
  accountTiersGranted     AccountTierGrant[]     @relation("AccountTierGrantor")
  // Stage 2 (T.20): single-use activation invitations (relation fields only).
  accountInvitations      AccountInvitation[]    @relation("AccountInvitationAccount")
  accountInvitationsSent  AccountInvitation[]    @relation("AccountInvitationCreator")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
}

// The tenant boundary: every Channel and Invitation now belongs to exactly
// one Workspace. `slug` is the human-facing identifier (e.g. for a future
// `/w/<slug>` URL); `ownerId` is distinct from WorkspaceMember's per-member
// ADMIN/MEMBER role — the owner is *the* workspace creator and can never be
// removed via the membership-role path (see workspaces.service.ts).
model Workspace {
  id                    String                 @id @default(uuid())
  name                  String
  slug                  String                 @unique
  // The one workspace every authenticated user can see/access regardless of
  // WorkspaceMember rows (see requireWorkspaceAccess in workspace.middleware.ts
  // and listWorkspacesForUser below) — distinct from DEFAULT_WORKSPACE_SLUG
  // (workspaces.service.ts), which only identifies *which* workspace this is
  // for seeding/backfill purposes. At most one row should ever have this set;
  // nothing in the schema enforces that, since Prisma has no partial-unique-
  // index support here — it's upheld by convention (only the seed script sets it).
  isDefault             Boolean                @default(false)
  // Batch 3 hierarchy: Organization → Workspace. Nullable on purpose: frozen
  // tooling (reset.ts) can still create a workspace without one; such an
  // orphan gets an organization lazily on first access
  // (organizations.service#ensureWorkspaceOrganization). SetNull so an
  // organization can never take its workspaces down with it.
  organizationId        String?
  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  description           String?
  channelCreationPolicy ChannelCreationPolicy  @default(MEMBERS)
  ownerId               String
  // RESTRICT (default): same reasoning as Channel.creator/Message.sender —
  // an owner's account being deleted must never silently vaporize their
  // workspace. Reassign ownerId to the sentinel first if that path is ever
  // built, same pattern as everywhere else in this schema.
  owner                 User                   @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members               WorkspaceMember[]
  channels              Channel[]
  messages              Message[]
  invitations           Invitation[]
  createdAt             DateTime               @default(now())
  // Reverse side of User.lastActiveWorkspace — every user currently "parked"
  // on this workspace as their landing page. Not used directly anywhere
  // (Prisma requires the back-relation to be declared), but deleting this
  // workspace SetNulls all of these via the FK above.
  usersLastActiveHere   User[]                 @relation("UserLastActiveWorkspace")
  joinRequests          WorkspaceJoinRequest[]
  inviteLinks           WorkspaceInviteLink[]
  projects              Project[]
  // Stage 3 (T.22): Member activation invitations bound to this workspace.
  accountInvitations    AccountInvitation[]    @relation("AccountInvitationWorkspace")

  @@index([organizationId])
}

// Batch 3 — the top of the hierarchy (Organization → Workspace → Channel).
// Existing workspaces were backfilled 1:1 into their own organization; the
// Default Workspace's organization is flagged isDefault and grants implicit
// MEMBER access to every account (frozen signup only creates workspace
// memberships). Ownership is a role row, not a column, so deleting a user
// (frozen admin flow) can never be blocked by an organization FK.
model Organization {
  id         String               @id @default(uuid())
  name       String
  slug       String               @unique
  isDefault  Boolean              @default(false)
  workspaces Workspace[]
  members    OrganizationMember[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

// Batch 3/C: Organization → Workspace → Project → Channel. Projects are
// optional; channels opt in via Channel.projectId. Projects are archived,
// never hard-deleted (they disappear only with their workspace).
model Project {
  id           String            @id @default(uuid())
  workspaceId  String
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  visibility   ProjectVisibility @default(PUBLIC)
  archivedAt   DateTime?
  // SetNull: attribution only — deleting an account (frozen admin flow)
  // must never be blocked by, or take down, a project.
  archivedById String?
  archivedBy   User?             @relation("ProjectArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?             @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  channels     Channel[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([workspaceId, archivedAt])
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

// Reusable "anyone with the link can request to join" invite links. These
// used to be stateless JWTs signed with the session JWT_SECRET, which meant a
// link token was *also* accepted as a login token by `authenticate` (audit
// finding SEC-01). Opaque random DB tokens can never be confused with a
// session JWT, and they can be expired/revoked individually.
model WorkspaceInviteLink {
  id          String    @id @default(uuid())
  // 256-bit random, base64url — never a JWT.
  token       String    @unique
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("InviteLinkCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  useCount    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, expiresAt])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  // Cascade: a WorkspaceMember row has no meaning once its Workspace is gone
  // — unlike Channel/Message, which get reassigned to a sentinel on user
  // deletion, there's no "orphaned membership" concept worth preserving.
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, workspaceId])
  // The unique constraint above indexes (userId, workspaceId) and userId
  // alone (leftmost prefix) — but not workspaceId by itself, which is
  // exactly what "list every member of this workspace" needs (workspace
  // admin panels, member counts, etc.). Without this, that's a full table
  // scan once WorkspaceMember has any real volume.
  @@index([workspaceId])
}

// Gates the reusable invite link (workspaces.routes.ts's /invite-link,
// /join) behind admin approval — clicking the link no longer joins
// instantly, it files one of these as PENDING for a workspace admin to
// approve/reject (see invitations.service.ts's requestToJoinWorkspace /
// resolveJoinRequest). One row per (user, workspace): re-requesting after a
// REJECTED resets the same row to PENDING rather than piling up duplicates.
model WorkspaceJoinRequest {
  id          String            @id @default(uuid())
  userId      String
  // Cascade: a pending/resolved request has no meaning once the requesting
  // account is gone.
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  // Cascade: same tenant-boundary reasoning as every other workspace-scoped
  // model here — deleting the workspace clears out its request queue too.
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, workspaceId])
  // Backs "list pending requests for this workspace" — the admin-facing
  // query this whole model exists for.
  @@index([workspaceId, status])
}

// Immutable trail of admin actions — bans, role changes, deletions. Written
// best-effort (see lib/auditLog.ts: a logging failure must never block or
// fail the admin action it's describing), so this is for accountability/
// review, not a source of truth anything else in the app depends on.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  // RESTRICT (the default): same reasoning as Message.sender / Channel.creator
  // — an admin's history must survive their own account being deleted. The
  // admin delete-user flow reassigns actorId to the "deleted user" sentinel
  // first (see admin.service.ts), same as it already does for messages/channels.
  actor      User     @relation("AuditLogActor", fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  details    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Temporary holding pen for a sign-up that hasn't proven ownership of its
// email address yet. No `User` row exists until verify-otp succeeds — this
// is deliberately a *separate* table, not a flag on User, so an unverified
// signup can never accidentally behave like a real account (log in, receive
// messages, etc.) no matter what other code touches the User model.
model OTPVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String
  // Already bcrypt-hashed before it ever reaches this table — same as a real
  // User row, never plaintext.
  password  String
  // HMAC-SHA256 of the 6-digit code (see lib/otp.ts), not the raw code — a
  // DB dump alone shouldn't hand out valid codes for pending signups.
  otpHash   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Invitation {
  id          String    @id @default(uuid())
  email       String
  token       String    @unique @default(uuid())
  status      String    @default("pending")
  inviterId   String
  inviter     User      @relation("UserInvites", fields: [inviterId], references: [id], onDelete: Cascade)
  workspaceId String
  // Cascade: an invitation to a workspace that no longer exists is void by
  // definition — nothing should keep it around.
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  // Neither foreign key had an index at all before this — "pending invites
  // for this workspace" and "invites this user sent" both did a full scan.
  @@index([workspaceId])
  @@index([inviterId])
}

model Channel {
  id             String            @id @default(uuid())
  name           String?
  description    String?
  // Emoji string chosen via emoji-picker-react, or the literal "hash" for
  // channels using the default lucide Hash icon (also the fallback for any
  // pre-existing channel created before this field existed).
  icon           String?           @default("hash")
  isDM           Boolean           @default(false)
  // A multi-person direct conversation (3+ participants). Always isDM=true as
  // well, so every "exclude DMs from public channel lists" filter keeps
  // working unchanged; 1:1 DM lookups filter isGroupDM=false.
  isGroupDM      Boolean           @default(false)
  createdBy      String
  // Deliberately left as the default RESTRICT (not Cascade/SetNull): a
  // channel's creator being deleted must never silently delete the channel.
  // The admin delete-user flow reassigns createdBy to a "deleted user"
  // sentinel *before* deleting the row (see admin.service.ts); anything else
  // that tries to delete a user directly still gets a safe FK failure.
  creator        User              @relation("UserCreatedChannels", fields: [createdBy], references: [id])
  messages       Message[]
  members        ChannelMember[]
  workspaceId    String
  // Cascade: the workspace is the tenant boundary — deleting it tears down
  // every channel (and, transitively, every message/member/reaction) scoped
  // to it. This is a rare, fully-intentional "delete this whole tenant"
  // action, not something that happens as a side effect of anything else.
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Batch 3/C: optional project. null = workspace level (every pre-existing
  // channel). Never set for General or DMs, and only to a project of the same
  // workspace (validated in projects.service.ts).
  projectId      String?
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // Batch 3/D: defaults keep every pre-existing channel public and
  // open-posting. ChannelMember.role stays a text column: 'admin' = Channel
  // Owner (legacy), 'moderator', 'member'.
  visibility     ChannelVisibility @default(PUBLIC)
  isAnnouncement Boolean           @default(false)
  topic          String?
  // Archived channels are read-only; nothing is deleted.
  archivedAt     DateTime?
  archivedById   String?
  archivedBy     User?             @relation("ChannelArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // No index on workspaceId at all before this — every channel-list load
  // (fires on every workspace switch, i.e. very high frequency) was a full
  // table scan once Channel has any real volume.
  @@index([workspaceId])
  @@index([projectId])
}

model Message {
  id            String         @id @default(uuid())
  content       String?
  fileUrl       String?
  fileName      String?
  fileType      String?
  isPinned      Boolean        @default(false)
  pollData      Json? // 👇 NAYA: Live polls save karne ke liye
  channelId     String
  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  // Denormalized from `channel.workspaceId` — Message already reaches its
  // Workspace transitively through Channel, but workspace-scoped queries
  // (admin analytics, cross-channel message search/moderation) were
  // otherwise stuck either joining through Channel or pre-fetching a channel
  // ID list first (see admin.service.ts's getAnalytics). A direct column
  // makes "every message in workspace X" a single indexed WHERE, at the cost
  // of an invariant every write path must uphold: this must always equal the
  // creating message's `channel.workspaceId` (see sockets/messages.handlers.ts).
  workspaceId   String
  // Cascade: same reasoning as Channel.workspace — deleting a workspace is
  // an intentional full-tenant teardown, and a message can't outlive both
  // the workspace it's denormalized against and (via channelId) its channel.
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  senderId      String
  // Same reasoning as Channel.creator above: RESTRICT is intentional so
  // message history can never be silently wiped by a user deletion. The
  // admin delete-user flow reassigns senderId to the sentinel user first.
  sender        User           @relation(fields: [senderId], references: [id])
  parentId      String?
  parent        Message?       @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Message[]      @relation("Thread")
  // Orphaned column from an abandoned mentions feature — already live in the
  // DB (two migrations applied there that never made it into this repo).
  // Declaring it here so schema.prisma matches reality; unused by app code.
  mentions      String[]       @default([])
  // Client-generated idempotency key for message:send. A client that retries
  // a send (timeout, reconnect, double-click) re-sends the same clientId, and
  // the (senderId, clientId) unique key guarantees exactly one row. Nullable
  // so every pre-existing row stays valid (Postgres treats NULLs as distinct).
  clientId      String?
  reactions     Reaction[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  // P2: set only when the author edits the content (updatedAt also moves on
  // pins, so it can't drive the "edited" indicator). Nullable and additive.
  editedAt      DateTime?

  @@unique([senderId, clientId])
  // Thread fetches, reply counts (`_count.replies` on every history page) and
  // the per-reply count after each send all filter on parentId.
  @@index([parentId, createdAt])
  // Matches the exact orderBy in messages.service.ts's cursor pagination:
  // channelId (equality filter), then createdAt+id descending as the
  // compound tiebreaker sort (id is needed because createdAt alone isn't a
  // stable order when messages land in the same millisecond — see the
  // comment in getChannelMessages). Without this, every page is a full scan
  // of the channel's messages sorted in memory.
  @@index([channelId, createdAt(sort: Desc), id(sort: Desc)])
  // Backs the workspace-scoped queries workspaceId was added for — most
  // recent-first across every channel in a workspace, without a join.
  @@index([workspaceId, createdAt(sort: Desc)])
}

model Reaction {
  id        String   @id @default(uuid())
  emoji     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // One reaction per user per emoji per message (re-clicking the same emoji
  // toggles it off in app logic rather than inserting a duplicate row).
  @@unique([userId, messageId, emoji])
  @@index([messageId])
}

// Powers @mention alerts, thread-reply alerts, and the sidebar's unread
// badge. `type` is a plain String (not an enum) on purpose — same reasoning
// as AuditLog.action above: the set of notification kinds is expected to
// keep growing (reactions, channel invites, etc.), and a String lets the
// application layer add a new kind without a schema migration for each one.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  // Cascade: unlike AuditLog/Message, a notification has no meaning once its
  // recipient is gone — it's an ephemeral inbox entry, not a historical
  // record anything else depends on.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // e.g. "MENTION", "REPLY" — see the model-level comment above.
  type      String
  messageId String
  // Cascade: same reasoning as Reaction.message — a notification pointing at
  // a message that's been deleted is stale clutter, not something worth
  // preserving with a dangling reference.
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Backs "my notifications, newest first" (the whole feed) and, since
  // isRead is the second column, an efficient unread-only variant of the
  // same query/count without a second index.
  @@index([userId, isRead, createdAt(sort: Desc)])
}

model ChannelMember {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDM              Boolean   @default(false)
  channelId         String
  channel           Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  role              String    @default("member")
  // Persistent read position (server-side source of truth for unread counts
  // across reloads, devices and tabs). Only ever moves forward. The default
  // means existing and newly created memberships start "caught up" instead of
  // treating a channel's whole history as unread.
  lastReadAt        DateTime  @default(now())
  lastReadMessageId String?
  // Earliest message this member may see. NULL = full history (public
  // channels, original DM participants). Set when someone is added to a group
  // DM without sharing prior history.
  historyFrom       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, channelId])
  // Same reasoning as WorkspaceMember.@@index([workspaceId]) above — the
  // unique constraint covers (userId, channelId) and userId alone, but not
  // channelId by itself, which is what every "who's in this channel" listing
  // (channel member includes, addable-members, etc.) actually filters by.
  @@index([channelId])
}

// Collaboration profile and preferences (Batch 2). Deliberately separate from
// User so no authentication-related table or column is modified.
model UserProfile {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // P2: optional display name (set by the user or a platform admin at account
  // creation); the unique username stays the identifier. Nullable and additive.
  displayName         String?
  title               String?
  bio                 String?
  timezone            String?
  // Reciprocal, like Microsoft Teams: when off, the user neither sends read
  // receipts nor sees anyone else's.
  readReceiptsEnabled Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Stage 1 (T.19) — the company hierarchy: Company Admin → Team Lead → Member.
//  - Company Admin is the existing platform admin (User.role = ADMIN, frozen
//    admin authentication) and is NOT represented here.
//  - TEAM_LEAD may create workspaces/organizations and hold elevated
//    workspace/organization roles; MEMBER may not.
//  - No row = MEMBER (deny by default): signup, admin "Create user" and every
//    pre-existing account start as members until a reviewed backfill or a
//    Company Admin grant says otherwise.
// Read from the database on every check (never from the JWT), so a change
// takes effect on the next request.
enum AccountTier {
  TEAM_LEAD
  MEMBER
}

model AccountTierGrant {
  userId      String      @id
  // Cascade: a tier means nothing without its account (and must never block
  // the frozen admin delete-user flow).
  user        User        @relation("AccountTierHolder", fields: [userId], references: [id], onDelete: Cascade)
  tier        AccountTier
  // Who granted it (a Company Admin, or the reviewed backfill = null).
  // SetNull: attribution only — deleting the grantor never removes the grant.
  grantedById String?
  grantedBy   User?       @relation("AccountTierGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tier])
  @@index([grantedById])
}

// Stage 2 (T.20) — single-use activation invitations for provisioned accounts
// (Company Admin → Team Lead now; Team Lead → Member later). No e-mail.
//  - The account is created up front with an unknowable random password, so
//    the normal login can never accept the temporary password.
//  - Only hashes are stored: SHA-256 of the 256-bit link token (looked up by
//    hash) and bcrypt of the temporary password (cleared once used/revoked).
//  - Activation consumes the row atomically (PENDING → ACCEPTED) and sets the
//    permanent password; no session token is ever issued by it.
//  - EXPIRED is derived: status PENDING with expiresAt in the past.
enum AccountInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model AccountInvitation {
  id                    String                  @id @default(uuid())
  // The provisioned account this invitation activates. Cascade: an
  // invitation means nothing without its account (and must never block the
  // frozen admin delete-user flow).
  userId                String
  user                  User                    @relation("AccountInvitationAccount", fields: [userId], references: [id], onDelete: Cascade)
  intendedTier          AccountTier
  tokenHash             String                  @unique
  tempPasswordHash      String?
  // SHA-256 of the account's password hash when the invitation was issued.
  // Activation refuses if the password was changed some other way since.
  credentialFingerprint String
  teamLabel             String?
  // Stage 3 (T.22): for a Member invitation, the Team Lead's workspace the
  // account joins on activation (null for Team Lead invitations). SetNull: a
  // deleted workspace leaves the invitation (Collab access only).
  workspaceId           String?
  workspace             Workspace?              @relation("AccountInvitationWorkspace", fields: [workspaceId], references: [id], onDelete: SetNull)
  status                AccountInvitationStatus @default(PENDING)
  expiresAt             DateTime
  failedAttempts        Int                     @default(0)
  // SetNull: attribution only — deleting the issuing admin keeps the record.
  createdById           String?
  createdBy             User?                   @relation("AccountInvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedAt            DateTime?
  revokedAt             DateTime?
  // 'ADMIN' | 'TOO_MANY_ATTEMPTS' | 'REISSUED'
  revokedReason         String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([userId, status])
  @@index([createdById])
  @@index([status, expiresAt])
  @@index([workspaceId, status])
}
