{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": ["server.ts", "app.ts", "config/**/*.ts", "modules/**/*.ts", "sockets/**/*.ts", "middleware/**/*.ts", "lib/**/*.ts", "utils/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
