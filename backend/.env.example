# SmartConnect backend configuration — copy to .env and fill in.
# Never commit real values. Production values live in the Render dashboard.

# PostgreSQL. Local example: postgresql://user@localhost:5432/smartconnect_dev
# Supabase: the SESSION pooler (port 5432, never 6543) with ?sslmode=require&connection_limit=5
DATABASE_URL=

# Long random string that signs session tokens (e.g. `openssl rand -hex 48`).
JWT_SECRET=

# The frontend's URL. Required in production; defaults to http://localhost:5174 locally.
APP_URL=

# File storage (required — the server refuses to start without them).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mail (invitations, password resets). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Calls: a TURN relay lets calls connect on restrictive networks.
# CALL_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# CALL_TURN_SECRET=            # coturn use-auth-secret (preferred: short-lived credentials)
# CALL_TURN_USERNAME=          # or static credentials
# CALL_TURN_CREDENTIAL=
# CALL_STUN_URLS=stun:stun.l.google.com:19302
# CALL_MAX_PARTICIPANTS=8

# PORT=3000
# TRUST_PROXY=                 # production default: 1 (Render's load balancer)

# T.33 — horizontal scaling (all optional; without REDIS_URL the server runs as
# a single instance with in-memory presence, calls and rate limits).
# Redis shared by every instance: Socket.IO adapter, presence, calls, rate limits.
# REDIS_URL=redis://localhost:6379        (rediss://… for TLS)
# Database connections per instance (applied unless the URL sets connection_limit).
# DATABASE_CONNECTION_LIMIT=10
# DATABASE_POOL_TIMEOUT=10
# HTTP_REQUEST_TIMEOUT_MS=120000
# SHUTDOWN_TIMEOUT_MS=15000
# PRESENCE_HEARTBEAT_MS=25000

# One-time first Company Admin (optional). Read only by `npm run admin:bootstrap`,
# never by the server. Run it once against a database with no admin yet, adding
# BOOTSTRAP_CONFIRM=CREATE_FIRST_COMPANY_ADMIN on the command line; it refuses if
# any admin exists. Sign in afterwards with the e-mail and password.
# Password: 12+ characters, at least three of lower/upper/digit/symbol. Clear it after use.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
