# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
dist/
build/
frontend/dist/
backend/dist/

# Uploads (user-generated files) — anchored to repo root so this doesn't
# also match backend/modules/uploads/, the source folder for the upload
# feature's code (a bare `uploads/` pattern matches a directory with that
# name at any depth, not just the runtime storage dir this is meant for).
backend/uploads/

# Environment files
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local
# Keep examples
!.env.example
!frontend/.env.example
!backend/.env.example

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# TypeScript build info
*.tsbuildinfo

# Vite cache
frontend/.vite/
