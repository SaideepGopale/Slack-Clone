# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
dist/
build/
frontend/dist/
backend/dist/

# Uploads (user-generated files) — anchored to repo root so this doesn't
# also match backend/modules/uploads/, the source folder for the upload
# feature's code (a bare `uploads/` pattern matches a directory with that
# name at any depth, not just the runtime storage dir this is meant for).
backend/uploads/

# Environment files
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local
# Local database credential file (P0) — never commit
backend/.slack-db-password
# Keep examples
!.env.example
!frontend/.env.example
!backend/.env.example

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# TypeScript build info
*.tsbuildinfo

# Vite cache
frontend/.vite/

# Playwright E2E artifacts (F1)
frontend/test-results/
frontend/playwright-report/

# Stage 1B (T.30) — private, generated and secret material that must never be uploaded
# Private audit record: kept local by the owner's decision.
/entireanalysis.md
# Stale generated Prisma client (unused; the app imports @prisma/client). Ignoring does
# not untrack it — the release stage runs `git rm -r --cached backend/lib/generated`.
backend/lib/generated/
# Key material, database dumps and backups
*.pem
*.key
*.p12
*.pfx
*.dump
*.sql.gz
*.bak
# Any other environment-file variant (the examples stay tracked)
.env.*
!.env.example
!frontend/.env.example
!backend/.env.example
# Local scratch, editor swap files and coverage output
/tmp/
*.tmp
*.swp
coverage/
